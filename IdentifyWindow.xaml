<Window x:Class="MediaForge.IdentifyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Identify Media" Width="1300" Height="900" WindowStartupLocation="CenterOwner">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Identify Media" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="SourceText" Foreground="Gray" Margin="0,4,0,0"/><TextBlock Text="Identify combines the file name, source name/path, disc structure, TMDB metadata and artwork. Choose the result below, review the episode preview, and optionally select chapters for each source." Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
<DockPanel Grid.Row="1" Margin="0,18,0,12"><Button Content="Auto Identify" Width="120" DockPanel.Dock="Right" Margin="8,0,0,0" Click="AutoIdentify_Click" ToolTip="Automatically determine Movie or TV Show and select the strongest TMDB match."/><Button Content="Search" Width="90" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Search_Click"/><ComboBox x:Name="TypeBox" Width="120" Margin="0,0,8,0"><ComboBoxItem Content="Movie"/><ComboBoxItem Content="TV Show"/></ComboBox><TextBox x:Name="QueryBox" VerticalContentAlignment="Center"/></DockPanel>
<DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged"><DataGrid.Columns><DataGridTemplateColumn Header="Poster" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding PosterUrl}" Width="45" Height="65" Stretch="Uniform"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Title" Binding="{Binding DisplayName}" Width="230"/><DataGridTextColumn Header="Type" Binding="{Binding DisplayType}" Width="70"/><DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="70"/><DataGridTextColumn Header="TMDB ID" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="Overview" Binding="{Binding Overview}" Width="*"/></DataGrid.Columns></DataGrid>
<Border Grid.Row="2" HorizontalAlignment="Right" Width="300" Height="180" Margin="0,0,12,12" Background="#0B1220" BorderBrush="#374151" BorderThickness="1" Padding="6" VerticalAlignment="Bottom">
    <Image x:Name="EpisodePreviewImage" Stretch="Uniform"/>
</Border>
<StackPanel Grid.Row="3"><TextBlock Text="TV Season / Episode mapping" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8"/><StackPanel Orientation="Horizontal"><TextBlock Text="Season:" VerticalAlignment="Center"/><ComboBox x:Name="SeasonBox" Width="320" Margin="8,0,12,0" SelectionChanged="SeasonBox_SelectionChanged" DisplayMemberPath="Display"/><Button Content="Auto Map Episodes" Click="AutoMap_Click" Margin="0,0,12,0"/><TextBlock x:Name="MappingHint" Foreground="Gray" VerticalAlignment="Center"/></StackPanel><DataGrid x:Name="MappingGrid" Height="230" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="File Name" Binding="{Binding Job.FileName}" Width="220" IsReadOnly="True"/><DataGridTextColumn Header="Source Name" Binding="{Binding Job.SourceName}" Width="180" IsReadOnly="True"/><DataGridTemplateColumn Header="Episode" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Display" SelectionChanged="EpisodeBox_SelectionChanged"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Start Ch." Binding="{Binding Job.ChapterStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75"/><DataGridTextColumn Header="End Ch." Binding="{Binding Job.ChapterEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75"/><DataGridTextColumn Header="Air Date" Binding="{Binding SelectedEpisode.AirDate}" Width="120" IsReadOnly="True"/><DataGridTextColumn Header="TMDB ID" Binding="{Binding SelectedEpisode.Id}" Width="90" IsReadOnly="True"/></DataGrid.Columns></DataGrid><Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
    <StackPanel><TextBlock Text="Manual TV Entry" FontWeight="SemiBold"/><TextBlock Text="Use this when automatic identification cannot find the show. This replaces the separate Manual TV window." Foreground="Gray" Margin="0,3,0,8"/>
    <WrapPanel><TextBlock Text="Show:" VerticalAlignment="Center"/><TextBox x:Name="ManualShowBox" Width="180" Margin="6,0,12,0"/><TextBlock Text="Year:" VerticalAlignment="Center"/><TextBox x:Name="ManualYearBox" Width="65" Margin="6,0,12,0"/><TextBlock Text="Season:" VerticalAlignment="Center"/><TextBox x:Name="ManualSeasonBox" Width="55" Margin="6,0,12,0"/><TextBlock Text="Episode:" VerticalAlignment="Center"/><TextBox x:Name="ManualEpisodeBox" Width="55" Margin="6,0,12,0"/><TextBlock Text="Episode Title:" VerticalAlignment="Center"/><TextBox x:Name="ManualEpisodeTitleBox" Width="220" Margin="6,0,12,0"/><Button Content="Use Manual TV" Click="ManualTvApply_Click" Padding="12,4"/></WrapPanel></StackPanel>
</Border>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="Cancel" Width="90" Margin="6" Click="Cancel_Click"/><Button Content="Apply Identification" Width="150" Margin="6" Click="Apply_Click"/></StackPanel></StackPanel>
</Grid></Window>
