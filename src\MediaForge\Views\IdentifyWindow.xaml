<Window x:Class="MediaForge.IdentifyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Identify Media" Width="1300" Height="900" WindowStartupLocation="CenterOwner">
<Window.Resources>
    <Style x:Key="ThemeComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#111827"/>
        <Setter Property="Foreground" Value="#F9FAFB"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#374151"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThemeComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#F9FAFB"/>
        <Setter Property="Background" Value="#111827"/>
        <Setter Property="BorderBrush" Value="#4B5563"/>
        <!-- Declarative template also covers DataGrid cells created after theme initialization. -->
        <Setter Property="Template" Value="{StaticResource ThemeComboBoxTemplate}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemeComboBoxItemStyle}"/>
    </Style>
</Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Identify Media" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="SourceText" Foreground="Gray" Margin="0,4,0,0"/><TextBlock Text="Identify combines filename and disc metadata with TMDB aired and DVD episode groups plus TVmaze. IMDb IDs cross-reference the same show where available. TVmaze data: CC BY-SA; attribution: tvmaze.com. Runtime and chapters estimate structure; DVD order maps disc tracks to aired episode records." Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
<DockPanel Grid.Row="1" Margin="0,18,0,12"><Button Content="Auto Identify" Width="120" DockPanel.Dock="Right" Margin="8,0,0,0" Click="AutoIdentify_Click" ToolTip="Determine the show, infer the season from source/disc clues, and suggest episode assignments."/><Button Content="Search" Width="90" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Search_Click"/><StackPanel Orientation="Horizontal" Margin="0,0,8,0"><Button x:Name="MovieButton" Content="Movie" Width="90" Height="30" Margin="0,0,4,0" Click="MovieButton_Click"/><Button x:Name="TvButton" Content="TV Show" Width="90" Height="30" Click="TvButton_Click"/></StackPanel><TextBox x:Name="QueryBox" VerticalContentAlignment="Center"/></DockPanel>
<DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged"><DataGrid.Columns><DataGridTemplateColumn Header="Poster" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding PosterUrl}" Width="45" Height="65" Stretch="Uniform"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Title" Binding="{Binding DisplayName}" Width="230"/><DataGridTextColumn Header="Type" Binding="{Binding DisplayType}" Width="70"/><DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="70"/><DataGridTextColumn Header="TMDB ID" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="Overview" Binding="{Binding Overview}" Width="*"/></DataGrid.Columns></DataGrid>
<Border Grid.Row="2" HorizontalAlignment="Right" Width="300" Height="180" Margin="0,0,12,12" Background="#0B1220" BorderBrush="#374151" BorderThickness="1" Padding="6" VerticalAlignment="Bottom">
    <Image x:Name="EpisodePreviewImage" Stretch="Uniform"/>
</Border>
<StackPanel Grid.Row="3"><TextBlock Text="TV Season / Episode mapping" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8"/><StackPanel Orientation="Horizontal"><TextBlock Text="Season:" VerticalAlignment="Center"/><ComboBox x:Name="SeasonBox" Style="{StaticResource ThemeComboBoxStyle}" Width="320" Margin="8,0,12,0" SelectionChanged="SeasonBox_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Auto Season" Click="AutoSeason_Click" Margin="0,0,8,0" ToolTip="Infer the season from existing job metadata, disc label, and episode-title clues."/><Button Content="Auto Map / Split" Click="AutoMap_Click" Margin="0,0,12,0" ToolTip="Uses explicit episode identifiers and episode-title similarity. Unmatched sources remain unassigned; runtime-based chapter suggestions require review."/><TextBlock x:Name="MappingHint" Foreground="Gray" VerticalAlignment="Center"/></StackPanel><DataGrid x:Name="MappingGrid" Height="230" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Source File" Binding="{Binding Job.SourceName}" Width="210" IsReadOnly="True"/><DataGridTemplateColumn Header="Structure" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StructureDisplay}" ToolTip="{Binding StructureDetail}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Match evidence" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MatchDisplay}" ToolTip="{Binding MatchDetail}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Episode" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource ThemeComboBoxStyle}" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="EpisodeBox_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Start Ch." Binding="{Binding ChapterStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75"/><DataGridTextColumn Header="End Ch." Binding="{Binding ChapterEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75"/><DataGridTextColumn Header="Air Date" Binding="{Binding SelectedEpisode.AirDate}" Width="120" IsReadOnly="True"/><DataGridTextColumn Header="Runtime" Binding="{Binding SelectedEpisode.RuntimeMinutes}" Width="70" IsReadOnly="True"/><DataGridTextColumn Header="TMDB ID" Binding="{Binding SelectedEpisode.Id}" Width="90" IsReadOnly="True"/></DataGrid.Columns></DataGrid><Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
    <StackPanel><TextBlock Text="Manual TV Entry" FontWeight="SemiBold"/><TextBlock Text="Use this when automatic identification cannot find the show. This replaces the separate Manual TV window." Foreground="Gray" Margin="0,3,0,8"/>
    <WrapPanel><TextBlock Text="Show:" VerticalAlignment="Center"/><TextBox x:Name="ManualShowBox" Width="180" Margin="6,0,12,0"/><TextBlock Text="Year:" VerticalAlignment="Center"/><TextBox x:Name="ManualYearBox" Width="65" Margin="6,0,12,0"/><TextBlock Text="Season:" VerticalAlignment="Center"/><TextBox x:Name="ManualSeasonBox" Width="55" Margin="6,0,12,0"/><TextBlock Text="Episode:" VerticalAlignment="Center"/><TextBox x:Name="ManualEpisodeBox" Width="55" Margin="6,0,12,0"/><TextBlock Text="Episode Title:" VerticalAlignment="Center"/><TextBox x:Name="ManualEpisodeTitleBox" Width="220" Margin="6,0,12,0"/><Button Content="Use Manual TV" Click="ManualTvApply_Click" Padding="12,4"/></WrapPanel></StackPanel>
</Border>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="Cancel" Width="90" Margin="6" Click="Cancel_Click"/><Button Content="Apply Identification" Width="150" Margin="6" Click="Apply_Click"/></StackPanel></StackPanel>
</Grid></Window>

