<Application x:Class="MediaForge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#16B8A6"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#F9FAFB"/>

    <ControlTemplate x:Key="ThemeComboBoxTemplate" TargetType="ComboBox">
      <Grid>
        <!-- Draw the control background FIRST so it cannot cover the selection text. -->
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"/>
        <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                      ClickMode="Press">
          <Grid>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="8,0,30,0"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
            <TextBlock Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0" IsHitTestVisible="False"
                       TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Grid>
        </ToggleButton>
        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
               Placement="Bottom"
               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True"
               MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" Padding="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="360">
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid>
    </ControlTemplate>
  </Application.Resources>
</Application>
