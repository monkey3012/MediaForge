<Window x:Class="MediaForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaForge" Height="900" Width="1450" MinHeight="600" MinWidth="950"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="MediaForge" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Disc → MakeMKV → HandBrake → Plex" Foreground="#9CA3AF" FontSize="14"/>
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Settings" Padding="18,8" Margin="8,0,0,0" Click="Settings_Click"/>
                <Button Content="Import Disc" Padding="18,8" Margin="8,0,0,0" Click="ImportDisc_Click"/>
                <Button Content="Import Files" Padding="18,8" Margin="8,0,0,0" Click="ImportFiles_Click"/>
                <Button x:Name="ThemeButton" Content="Light Mode" Padding="18,8" Margin="8,0,0,0" Click="Theme_Click"/>
                <Button Content="Process / Add to Queue" Padding="18,8" Margin="8,0,0,0" Click="Process_Click"/>
                <Button x:Name="PauseQueueButton" Content="Pause Queue" Padding="18,8" Margin="8,0,0,0" Click="PauseQueue_Click"/>
                <Button Content="Live Console" Padding="18,8" Margin="8,0,0,0" Click="Console_Click"/>
                <Button Content="Organize Selected" Padding="18,8" Margin="8,0,0,0" Click="Organize_Click"/>
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Background="#1F2937" CornerRadius="10" Padding="18" Margin="0,0,14,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Processing Queue" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Identify Selected" Padding="12,5" Margin="0,0,6,0" Click="Identify_Click" ToolTip="Identify the selected job or jobs using show, disc, runtime, and episode metadata."/>
                        <Button Content="Move Up" Padding="12,5" Margin="0,0,6,0" Click="MoveSelectedUp_Click"/>
                        <Button Content="Move Down" Padding="12,5" Margin="0,0,6,0" Click="MoveSelectedDown_Click"/>
                        <Button Content="Remove from Processing List" Padding="12,5" Margin="0,0,6,0" Click="RemoveSelectedFromQueue_Click"/>
                        <Button Content="Retry Failed/Cancelled" Padding="12,5" Click="RetrySelected_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                              Background="#111827" Foreground="#111827" RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Queue #" Binding="{Binding QueuePosition}" Width="70"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="85"/>
                            <DataGridTextColumn x:Name="ColStatus" Header="Status" Binding="{Binding Status}" Width="105"/>
                            <DataGridTemplateColumn x:Name="ColFileName" Header="File Name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SourceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="File name used by MediaForge for identification and display. The underlying source path remains unchanged."
                                                 Foreground="{DynamicResource WindowForegroundBrush}"
                                                 Background="Transparent"
                                                 BorderThickness="0" Padding="2" LostFocus="SourceName_LostFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColType" Header="Type" Binding="{Binding MediaType}" Width="100"/>
                            <DataGridTextColumn x:Name="ColTitle" Header="Show / Movie" Binding="{Binding Title}" Width="150"/>
                            <DataGridTextColumn x:Name="ColSeason" Header="Season" Binding="{Binding Season}" Width="65"/>
                            <DataGridTextColumn x:Name="ColEpisode" Header="Episode #" Binding="{Binding Episode}" Width="75"/>
                            <DataGridTextColumn x:Name="ColEpisodeTitle" Header="Episode Title" Binding="{Binding EpisodeTitle}" Width="160"/>
                            <DataGridTextColumn x:Name="ColStage" Header="Stage" Binding="{Binding Stage}" Width="140"/>
                            <DataGridTextColumn x:Name="ColProgress" Header="Progress" Binding="{Binding Progress, StringFormat={}{0}%}" Width="80"/>
                            <DataGridTextColumn x:Name="ColRippedSize" Header="Ripped Size" Binding="{Binding RippedSizeDisplay}" Width="100"/>
                            <DataGridTextColumn x:Name="ColFinalSize" Header="Final Size" Binding="{Binding EncodedSizeDisplay}" Width="100"/>
                            <DataGridTextColumn x:Name="ColSaved" Header="Saved" Binding="{Binding SizeSavingsDisplay}" Width="125"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" Background="#1F2937" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Workflow" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Queue behavior" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,5"/>
                    <TextBlock Text="Select multiple jobs and click Process / Add to Queue. Jobs run one at a time in the order they were selected. You can add more jobs while the queue is running." TextWrapping="Wrap" Foreground="#D1D5DB"/>
                    <TextBlock Text="Pause Queue stops the queue from starting the next job. Stop Current cancels the active MakeMKV or HandBrake process." TextWrapping="Wrap" Foreground="#9CA3AF" Margin="0,10,0,0"/>
                    <TextBlock Text="Live Console" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,5"/>
                    <TextBlock Text="The console shows the actual stdout/stderr lines coming from MakeMKV and HandBrakeCLI, including the command that was launched." TextWrapping="Wrap" Foreground="#9CA3AF"/>
                    <Separator Margin="0,18"/>
                    <TextBlock Text="Workflow" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="1. Import a disc or existing MKV files" Margin="0,8,0,0"/>
                    <TextBlock Text="2. Identify/map the media when needed" Foreground="#9CA3AF" Margin="0,4"/>
                    <TextBlock Text="3. Add jobs to the processing queue" Foreground="#9CA3AF" Margin="0,4"/>
                    <TextBlock Text="4. HandBrake encodes each queued MKV" Foreground="#9CA3AF" Margin="0,4"/>
                    <TextBlock Text="5. Identified jobs are moved into Plex naming" Foreground="#9CA3AF" Margin="0,4"/>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Background="#1F2937" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <Grid MinHeight="82">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="114"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Canvas Width="110" Height="72" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse x:Name="ForgeDisc" Width="52" Height="52" Stroke="#D1D5DB" StrokeThickness="5" Canvas.Left="7" Canvas.Top="5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="ForgeDiscRotate" CenterX="26" CenterY="26"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="13" Height="13" Fill="#D1D5DB" Canvas.Left="26" Canvas.Top="24"/>
                        <Path Stroke="#F97316" StrokeThickness="5" Data="M 0,63 L 110,63"/>
                        <!-- The mirrored blacksmith hammer sits to the right of the disc and strikes away from it. -->
                        <Canvas Canvas.Left="99" Canvas.Top="0">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="ForgeHammerRotate" CenterX="7" CenterY="61" Angle="18"/>
                            </Canvas.RenderTransform>
                            <Canvas>
                                <Canvas.RenderTransform>
                                    <ScaleTransform ScaleX="-0.65" CenterX="7" CenterY="61"/>
                                </Canvas.RenderTransform>
                                <!-- Long wood handle with a heavy cross-peen head and flat striking face. -->
                                <Path Fill="#8B5A34" Stroke="#4B2E1F" StrokeThickness="1.5"
                                      Data="M 24,19 L 31,23 L 10,63 L 4,60 Z"/>
                                <Path Fill="#9CA3AF" Stroke="#374151" StrokeThickness="1.5"
                                      Data="M 23,8 L 6,9 L 2,12 L 4,16 L 22,20 L 29,18 L 47,21 L 54,19 L 57,14 L 54,9 L 47,7 L 29,9 Z"/>
                                <Path Stroke="#E5E7EB" StrokeThickness="1.5" Data="M 28,10 L 47,9 L 51,11"/>
                                <Path Stroke="#4B5563" StrokeThickness="1.5" Data="M 54,10 L 55,13 L 55,17 L 53,19"/>
                                <Path Fill="#6B7280" Stroke="#374151" StrokeThickness="1" Data="M 24,19 L 31,21 L 28,27 L 22,24 Z"/>
                            </Canvas>
                        </Canvas>
                    </Canvas>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Forging Progress" FontSize="17" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="ForgeProgressBar" Height="14" Margin="0,8,12,0" Minimum="0" Maximum="100">
                            <ProgressBar.Resources><Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#F97316"/><Setter Property="Background" Value="#374151"/></Style></ProgressBar.Resources>
                        </ProgressBar>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="ForgeProgressText" Text="0%" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Background="#1F2937" CornerRadius="10" Padding="14" Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Queue:" FontWeight="SemiBold"/>
                        <TextBlock x:Name="QueueCountText" Text=" 0 pending" Margin="8,0,0,0" Foreground="#9CA3AF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Current:" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentJobText" Text=" None" Margin="8,0,0,0" Foreground="#9CA3AF"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open Live Console" Padding="18,7" Click="Console_Click"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="FooterStatusText" Margin="2,10,0,0" Foreground="#9CA3AF"/>
    </Grid>
</Window>
