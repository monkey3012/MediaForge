<Window x:Class="MediaForge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaForge Settings" Width="760" Height="650" MinWidth="650" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ThemeComboBoxItemStyle" TargetType="ComboBoxItem"><Setter Property="Background" Value="#111827"/><Setter Property="Foreground" Value="#F9FAFB"/><Setter Property="Padding" Value="8,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#374151"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ThemeComboBoxStyle" TargetType="ComboBox"><Setter Property="Foreground" Value="#F9FAFB"/><Setter Property="Background" Value="#111827"/><Setter Property="BorderBrush" Value="#4B5563"/><Setter Property="ItemContainerStyle" Value="{StaticResource ThemeComboBoxItemStyle}"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Theme" Margin="0,0,0,4"/><ComboBox x:Name="ThemeBox" Style="{StaticResource ThemeComboBoxStyle}" Width="180" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="ThemeBox_SelectionChanged"><ComboBoxItem Content="Dark Mode"/><ComboBoxItem Content="Light Mode"/></ComboBox>
                <TextBlock Text="Applications" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Button Content="Detect Applications" Width="150" HorizontalAlignment="Left" Margin="0,0,0,14" Click="DetectApplications_Click"/>
                <TextBlock Text="MakeMKV CLI"/>
                <DockPanel Margin="0,4,0,14">
                    <Grid DockPanel.Dock="Right" Width="322">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="89"/><ColumnDefinition Width="129"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Auto Detect" Width="100" HorizontalAlignment="Left" Click="DetectMakeMkv_Click"/>
                        <Button Grid.Column="1" Content="Browse..." Width="85" HorizontalAlignment="Left" Click="BrowseMakeMkv_Click"/>
                        <Button Grid.Column="2" Content="Download MakeMKV" Width="125" HorizontalAlignment="Left" Click="DownloadMakeMkv_Click"/>
                    </Grid>
                    <TextBox x:Name="MakeMkvBox"/>
                </DockPanel>
                <TextBlock Text="HandBrakeCLI"/>
                <TextBlock Text="HandBrake GUI does not guarantee that HandBrakeCLI.exe is installed. MediaForge needs the separate HandBrakeCLI executable." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <DockPanel Margin="0,4,0,14">
                    <Grid DockPanel.Dock="Right" Width="322">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="89"/><ColumnDefinition Width="129"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Auto Detect" Width="100" HorizontalAlignment="Left" Click="DetectHandBrake_Click"/>
                        <Button Grid.Column="1" Content="Browse..." Width="85" HorizontalAlignment="Left" Click="BrowseHandBrake_Click"/>
                        <Button Grid.Column="2" Content="Download CLI" Width="125" HorizontalAlignment="Left" Click="DownloadHandBrakeCli_Click"/>
                    </Grid>
                    <TextBox x:Name="HandBrakeBox"/>
                </DockPanel>
                <TextBlock Text="Episode title-card reading" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,12"/>
                <TextBlock Text="Optional local tools let Auto Identify sample title cards around 45 seconds into each episode segment. Frames stay on this PC." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="FFmpeg"/>
                <DockPanel Margin="0,4,0,10">
                    <Grid DockPanel.Dock="Right" Width="322">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="89"/><ColumnDefinition Width="129"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Auto Detect" Width="100" HorizontalAlignment="Left" Click="DetectFfmpeg_Click"/>
                        <Button Grid.Column="1" Content="Browse..." Width="85" HorizontalAlignment="Left" Click="BrowseFfmpeg_Click"/>
                    </Grid>
                    <TextBox x:Name="FfmpegBox"/>
                </DockPanel>
                <TextBlock Text="Tesseract OCR"/>
                <DockPanel Margin="0,4,0,14">
                    <Grid DockPanel.Dock="Right" Width="322">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="89"/><ColumnDefinition Width="129"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Auto Detect" Width="100" HorizontalAlignment="Left" Click="DetectTesseract_Click"/>
                        <Button Grid.Column="1" Content="Browse..." Width="85" HorizontalAlignment="Left" Click="BrowseTesseract_Click"/>
                    </Grid>
                    <TextBox x:Name="TesseractBox"/>
                </DockPanel>
                <TextBlock Text="When either tool is missing, title-card evidence is skipped and normal filename, DVD-order, and episode metadata matching continues." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <TextBlock Text="HandBrake preset"/>
                <DockPanel Margin="0,4,0,14">
                    <Button Content="Refresh Presets" Width="115" DockPanel.Dock="Right" Margin="8,0,0,0" Click="RefreshPresets_Click"/>
                    <ComboBox x:Name="PresetBox" Style="{StaticResource ThemeComboBoxStyle}" VerticalContentAlignment="Center" ToolTip="Select a preset available to HandBrakeCLI. Custom presets are imported from your HandBrake presets.json."/>
                </DockPanel>
                <TextBlock Text="MediaForge automatically imports your HandBrake GUI presets.json before processing, so custom presets are available to HandBrakeCLI." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="TMDB" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,12"/>
                <TextBlock Text="TMDB API Read Access Token"/><PasswordBox x:Name="TmdbBox" Margin="0,4,0,4"/>
                <TextBlock Text="MediaForge checks PATH, standard installation folders, and common user folders such as Downloads/Desktop for HandBrakeCLI.exe. You can also browse directly to the executable." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <TextBlock Text="Use a TMDB API Read Access Token. It is stored locally in MediaForge settings." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="Queue Columns" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,12"/>
                <TextBlock Text="Choose which columns are shown in the Processing Queue." Foreground="Gray" Margin="0,0,0,6"/>
                <WrapPanel x:Name="QueueColumnsPanel" Margin="0,0,0,12">
                    <CheckBox Content="Status" Tag="Status" Margin="0,0,14,6"/>
                    <CheckBox Content="File Name" Tag="File Name" Margin="0,0,14,6"/><CheckBox Content="Type" Tag="Type" Margin="0,0,14,6"/>
                    <CheckBox Content="Title" Tag="Title" Margin="0,0,14,6"/>
                    <CheckBox Content="Stage" Tag="Stage" Margin="0,0,14,6"/>
                    <CheckBox Content="Progress" Tag="Progress" Margin="0,0,14,6"/>
                    <CheckBox Content="Ripped Size" Tag="Ripped Size" Margin="0,0,14,6"/>
                    <CheckBox Content="Final Size" Tag="Final Size" Margin="0,0,14,6"/>
                    <CheckBox Content="Saved" Tag="Saved" Margin="0,0,14,6"/>
                </WrapPanel>

                <TextBlock Text="File Locations" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,12"/>
                <TextBlock Text="MKV rip folder"/>
                <DockPanel Margin="0,4,0,14">
                    <Button Content="Browse..." Width="90" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseMkv_Click"/>
                    <TextBox x:Name="MkvBox"/>
                </DockPanel>
                <TextBlock Text="Temporary encoding folder"/>
                <DockPanel Margin="0,4,0,14">
                    <Button Content="Browse..." Width="90" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseTemp_Click"/>
                    <TextBox x:Name="TempBox"/>
                </DockPanel>
                <TextBlock Text="Final Movies folder (.mp4)"/>
                <DockPanel Margin="0,4,0,14">
                    <Button Content="Browse..." Width="90" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseMovies_Click"/>
                    <TextBox x:Name="MoviesBox"/>
                </DockPanel>
                <TextBlock Text="Final TV Shows folder (.mp4)"/>
                <DockPanel Margin="0,4,0,14">
                    <Button Content="Browse..." Width="90" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseTv_Click"/>
                    <TextBox x:Name="TvBox"/>
                </DockPanel>

                <Border Background="#10000000" CornerRadius="6" Padding="12" Margin="0,4,0,8">
                    <TextBlock Text="MKV rip folder is the initial destination for MakeMKV output. The temporary encoding folder holds intermediate MP4 files until MediaForge moves them into the final Movies or TV Shows folder." TextWrapping="Wrap" Foreground="Gray"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="6" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Margin="6" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
